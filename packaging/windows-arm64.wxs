<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="GlobeCraft" Manufacturer="GlobeCraft" Version="$(var.Version)"
           Scope="perMachine" UpgradeCode="2dd9ce9e-10dc-56ac-91f3-0f508faf2572">
    <MajorUpgrade DowngradeErrorMessage="A newer GlobeCraft version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="GlobeCraft.exe" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="GlobeCraft.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/FireflyTheReal/GlobeCraft" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="GlobeCraft">
        <Component Id="Application" Guid="*">
          <File Id="GlobeCraftExe" Source="$(var.Binary)" KeyPath="yes">
            <Shortcut Id="LaunchGlobeCraft" Name="GlobeCraft" Directory="ProgramMenuFolder"
                      Advertise="yes" WorkingDirectory="INSTALLFOLDER" Icon="GlobeCraft.exe" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <Feature Id="MainFeature" Title="GlobeCraft" Level="1">
      <ComponentRef Id="Application" />
    </Feature>
  </Package>
</Wix>
